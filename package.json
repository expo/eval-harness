{
  "name": "eval-experiments",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "bun run build && tsc --noEmit",
    "test:ts": "bun run build && bun test eval_harness && bun run test:packages",
    "test:python": "PYTHONPATH=. uv run --group test python -m unittest discover -s eval_harness -p 'test_*.py'",
    "test:all": "bun run typecheck && bun run test:ts && bun run test:python",
    "build": "bun run --cwd packages/source-scan build",
    "test:packages": "bun run --cwd packages/source-scan test",
    "postinstall": "bun run build",
    "format": "oxfmt --write 'packages/**' '.github/**' package.json tsconfig.json .oxfmtrc.json 'scripts/**/*.{ts,js,mjs,cjs}' --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check 'packages/**' '.github/**' package.json tsconfig.json .oxfmtrc.json 'scripts/**/*.{ts,js,mjs,cjs}' --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "tar": "^7.5.22",
    "@expo/source-scan": "workspace:*"
  },
  "devDependencies": {
    "@expo/config": "57.0.7",
    "@expo/require-utils": "57.0.4",
    "@types/bun": "1.3.14",
    "fast-check": "4.9.0",
    "oxfmt": "0.67.0",
    "typescript": "catalog:"
  },
  "workspaces": [
    "packages/*"
  ],
  "catalog": {
    "@babel/parser": "^7.29.8",
    "typescript": "7.0.2"
  }
}
