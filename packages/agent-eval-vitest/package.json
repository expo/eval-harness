{
  "name": "@expo/agent-eval-vitest",
  "version": "0.1.0",
  "type": "module",
  "description": "Colocated agent evaluations with independent Vitest checks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/eval-experiments.git",
    "directory": "packages/agent-eval-vitest"
  },
  "files": [
    "build",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./claude": {
      "types": "./build/claude.d.ts",
      "default": "./build/claude.js"
    },
    "./ollama": {
      "types": "./build/ollama.d.ts",
      "default": "./build/ollama.js"
    }
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run --cwd ../source-scan build && bun scripts/build.mts",
    "test": "bun test src/__tests__",
    "prepack": "bun run build",
    "test:pack": "bun scripts/smoke-pack.mts && bun scripts/smoke-pack.mts bun",
    "test:e2e": "bun run build && vitest run --config e2e/vitest.config.ts"
  },
  "dependencies": {
    "@babel/parser": "catalog:"
  },
  "peerDependencies": {
    "vitest": ">=4.1.0 <5"
  },
  "devDependencies": {
    "vitest": "4.1.11",
    "@types/node": "26.1.2",
    "@expo/source-scan": "workspace:*",
    "rollup": "catalog:",
    "rollup-plugin-dts": "catalog:",
    "typescript": "catalog:",
    "@typescript/typescript6": "catalog:"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
