{
  "name": "@expo/skill-analyzer",
  "version": "0.1.0",
  "type": "module",
  "description": "Bun skill-use analysis for authored app artifacts: trace triggers, static uptake, and offline reports",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/eval-experiments.git",
    "directory": "packages/skill-analyzer"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "build",
    "LICENSE",
    "MIGRATION.md",
    "bin"
  ],
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./cli": {
      "types": "./build/main.d.ts",
      "import": "./build/main.js"
    },
    "./artifacts": {
      "types": "./build/artifacts.d.ts",
      "import": "./build/artifacts.js"
    },
    "./utils": {
      "types": "./build/utils.d.ts",
      "import": "./build/utils.js"
    },
    "./analysis": {
      "types": "./build/analysis.d.ts",
      "import": "./build/analysis.js"
    },
    "./uptake_checks/trigger": {
      "types": "./build/uptake_checks/trigger.d.ts",
      "import": "./build/uptake_checks/trigger.js"
    },
    "./uptake_checks/registry": {
      "types": "./build/uptake_checks/registry.d.ts",
      "import": "./build/uptake_checks/registry.js"
    },
    "./uptake_checks/index": {
      "types": "./build/uptake_checks/index.d.ts",
      "import": "./build/uptake_checks/index.js"
    },
    "./uptake_checks/code_checks": {
      "types": "./build/uptake_checks/code_checks.d.ts",
      "import": "./build/uptake_checks/code_checks.js"
    },
    "./build_health/node_parser": {
      "types": "./build/build_health/node_parser.d.ts",
      "import": "./build/build_health/node_parser.js"
    },
    "./build_health/syntax_check": {
      "types": "./build/build_health/syntax_check.d.ts",
      "import": "./build/build_health/syntax_check.js"
    },
    "./build_health/bundle_check": {
      "types": "./build/build_health/bundle_check.d.ts",
      "import": "./build/build_health/bundle_check.js"
    }
  },
  "bin": {
    "skill-analyzer": "./bin/skill-analyzer.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run --cwd ../source-scan build && bun scripts/build.mjs",
    "prepack": "bun run build",
    "test": "bun test tests",
    "test:pack": "node scripts/smoke-pack.mjs && node scripts/smoke-pack.mjs bun"
  },
  "dependencies": {
    "tar": "catalog:",
    "@babel/parser": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "@expo/source-scan": "workspace:*",
    "rollup": "catalog:",
    "rollup-plugin-dts": "catalog:",
    "@typescript/typescript6": "catalog:"
  }
}
