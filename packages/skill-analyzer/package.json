{
  "name": "@expo/skill-analyzer",
  "version": "0.1.0",
  "type": "module",
  "description": "Bun skill-use analysis for authored app artifacts: trace triggers, static uptake, and offline reports",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/eval-experiments.git",
    "directory": "packages/skill-analyzer"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./cli": {
      "types": "./src/main.ts",
      "import": "./src/main.ts"
    },
    "./artifacts": {
      "types": "./src/artifacts.ts",
      "import": "./src/artifacts.ts"
    },
    "./utils": {
      "types": "./src/utils.ts",
      "import": "./src/utils.ts"
    },
    "./analysis": {
      "types": "./src/analysis.ts",
      "import": "./src/analysis.ts"
    },
    "./uptake_checks/trigger": {
      "types": "./src/uptake_checks/trigger.ts",
      "import": "./src/uptake_checks/trigger.ts"
    },
    "./uptake_checks/registry": {
      "types": "./src/uptake_checks/registry.ts",
      "import": "./src/uptake_checks/registry.ts"
    },
    "./uptake_checks/index": {
      "types": "./src/uptake_checks/index.ts",
      "import": "./src/uptake_checks/index.ts"
    },
    "./uptake_checks/code_checks": {
      "types": "./src/uptake_checks/code_checks.ts",
      "import": "./src/uptake_checks/code_checks.ts"
    },
    "./build_health/node_parser": {
      "types": "./src/build_health/node_parser.ts",
      "import": "./src/build_health/node_parser.ts"
    },
    "./build_health/syntax_check": {
      "types": "./src/build_health/syntax_check.ts",
      "import": "./src/build_health/syntax_check.ts"
    },
    "./build_health/bundle_check": {
      "types": "./src/build_health/bundle_check.ts",
      "import": "./src/build_health/bundle_check.ts"
    }
  },
  "bin": {
    "skill-analyzer": "./src/main.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../source-scan/scripts/copy-source.mjs && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "bun test tests",
    "test:pack": "node scripts/smoke-pack.mjs"
  },
  "dependencies": {
    "tar": "^7.5.22",
    "@babel/parser": "^7.29.8"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
