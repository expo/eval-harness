{
  "name": "@expo/source-scan",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared source-scanning helpers for Expo eval harnesses: comment stripping and Babel AST walking",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/eval-experiments.git",
    "directory": "packages/source-scan"
  },
  "files": [
    "build"
  ],
  "main": "./build/index.js",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./strip-comments": {
      "types": "./build/strip-comments.d.ts",
      "import": "./build/strip-comments.js"
    },
    "./walk": {
      "types": "./build/walk.d.ts",
      "import": "./build/walk.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "bun test src",
    "test:pack": "node scripts/smoke-pack.mjs"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "types": "./build/index.d.ts"
}
